# Copy to .env next to docker-compose.yml, then edit.
# For a public production host: ENVIRONMENT=production, COOKIE_SECURE=true,
# APP_URL=https://your-domain.example (TLS terminated by a proxy).

ENVIRONMENT=development
COOKIE_SECURE=false
APP_URL=http://localhost:8000
PORT=8000

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# local | s3
STORAGE_BACKEND=local

# Optional integrations (leave disabled until configured)
EMAIL_PROVIDER=disabled
AI_PROVIDER=disabled
