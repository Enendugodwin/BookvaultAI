# ---------------------------------------------------------------------------
# YVO's Book Vault - environment template. Never commit real secrets.
# Copy to .env (local) or set these variables in your hosting dashboard.
# See docs/ENVIRONMENT.md for the full reference.
# ---------------------------------------------------------------------------

# Required in every environment
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Local/container database. On Vercel, connecting Vercel Postgres injects
# POSTGRES_URL / POSTGRES_URL_NON_POOLING and the app uses those automatically.
DATABASE_URL=sqlite:///./bookvault.db
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts automatically granted administrator access (comma-separated).
# Only list email addresses you control; remove or change before sharing a deployment.
ADMIN_EMAILS=enendugodwin@gmail.com

# Session / cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=720

# Development only: return password-reset tokens in API responses.
# Must be false in production.
EXPOSE_RESET_TOKEN=true

# Catalogue (optional Google Books key raises quota; Open Library needs none)
GOOGLE_BOOKS_API_KEY=
CATALOGUE_TIMEOUT_SECONDS=10
CATALOGUE_CACHE_MINUTES=720

# AI provider: disabled | openai | ollama
# Disabled by default. Users must also enable AI and external-processing
# consent in Settings before any provider is called.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_DAILY_REQUESTS_PER_USER=25
AI_MAX_INPUT_CHARS=24000

# Email: disabled | resend
# In-app notifications work with email disabled.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=YVO's Book Vault <no-reply@example.com>

# Object storage: local | s3 | vercel_blob
# vercel_blob is the serverless default; use a private Blob store.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional. Leave empty for R2/AWS default encryption, or set AES256.
S3_SERVER_SIDE_ENCRYPTION=
# Vercel Blob. A connected store injects these on Vercel. For local testing,
# set BLOB_READ_WRITE_TOKEN to a store token.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Serverless / job execution
# Migrations run lazily on cold start with a PostgreSQL advisory lock.
AUTO_MIGRATE=true
# On Vercel this is forced on automatically; set true on other hosts to process
# user-triggered jobs inside the request instead of running the worker.
INLINE_JOBS=false
# Vercel Cron authenticates with Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
CRON_JOB_LIMIT=2

# Optional: serve a built frontend from the API process (single-container).
# Leave empty for the separate Vite dev server / Vercel deployment.
FRONTEND_DIST_DIR=

# Limits / operations
# Vercel Functions cap request bodies near 4.5 MB; use 4 on Vercel.
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=5000
LOG_LEVEL=INFO
SENTRY_DSN=
